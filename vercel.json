{
  "functions": {
    "api/war-payout.js": { "maxDuration": 60 },
    "api/armory-tracker.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/war-payout?cron=1", "schedule": "5 0 * * *" }
  ],
  "rewrites": [
    { "source": "/steadfast/:code.png", "destination": "/api/war-payout?steadfast=:code" },
    { "source": "/((?!api/|.*\\.[\\w]+$).*)", "destination": "/index.html" }
  ]
}
